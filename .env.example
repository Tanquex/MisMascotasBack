# Application
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# Database (PostgreSQL - Can use individual variables or DATABASE_URL)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=registro_mascotas
DB_SSL=false

# JWT Security (Generate high-entropy keys for production)
JWT_SECRET=super-secret-key-change-in-production-2026
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super-refresh-secret-key-change-in-production-2026
JWT_REFRESH_EXPIRES_IN=7d

# Throttler (DDoS & Brute Force Protection)
THROTTLE_TTL=60
THROTTLE_LIMIT=100
